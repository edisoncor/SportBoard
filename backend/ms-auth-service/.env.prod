# Configuración de Producción - SportBoard Auth Service
# IMPORTANTE: Cambiar estos valores en producción real

# Django Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=0
ENVIRONMENT=production
ALLOWED_HOSTS=localhost,127.0.0.1,kong,nginx,api

# Database Configuration
DATABASE_NAME=sportboard_db
DATABASE_USER=sportboard_user
DATABASE_PASSWORD=sportboard_pass_secure_123
DATABASE_HOST=db
DATABASE_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123_secure

# Email Configuration (configurar con tu proveedor de email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@sportboard.com

# Security Settings
USE_TLS=False
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Flower Monitoring
FLOWER_BASIC_AUTH=admin:admin123

# Kong Database
KONG_DATABASE=postgres
KONG_PG_HOST=kong-database
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong
KONG_PG_DATABASE=kong

# Logging Level
LOG_LEVEL=INFO

# Performance Settings
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
